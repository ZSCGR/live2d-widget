{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "declaration": true,
    "rootDir": "src",
    "outDir": "build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "removeComments": true,
    "allowJs": true,
    "types": ["node"],
    "paths": {
      "@framework/*": [
        "./src/CubismSdkForWeb-5-r.4/Framework/src/*"
      ],
      "@demo/*": [
        "./src/CubismSdkForWeb-5-r.4/Samples/TypeScript/Demo/src/*"
      ]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "src/CubismSdkForWeb-*/Samples/TypeScript/Demo/vite.config.mts"
  ]
}
